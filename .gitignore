# Node / frontend
node_modules/
ui/dist/
ui/dist-export/

# Claude Code worktrees (isolated workspaces for in-progress work)
.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Secrets & env — samples live in config/, real values never in git
.env
*.env
!*.env.example
!.env.example
*.key
*service-account*.json
# Real UI users map lives outside the repo (server secrets); only the .example is tracked
config/ui-users.json
deploy/local/ui-users.json

# Deliberately local-only working files. Untracked and unignored is one
# `git add -A` away from being committed by accident: the chat log is a
# transcript of local bot sessions, and the offline Dockerfile is a recipe for
# building without a registry on this machine — neither is how the server builds.
control-bot/chathistorylog.txt
deploy/ui-backend.offline.Dockerfile

# Editor / OS
.vscode/
.idea/
.DS_Store

# Dev tooling caches
.pytest_cache/
.ruff_cache/
*.log
.superpowers/
