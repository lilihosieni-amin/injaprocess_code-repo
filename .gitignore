# Node / frontend
node_modules/
ui/dist/
ui/dist-export/

# Playwright — the browser check of R6. The specs and the harness are committed;
# its screenshots and reports are working output.
ui/e2e/__shots__/
ui/test-results/
ui/playwright-report/

# Claude Code worktrees (isolated workspaces for in-progress work)
.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Secrets & env — samples live in config/, real values never in git
.env
*.env
!*.env.example
!.env.example
*.key
*service-account*.json
# ui-users.json is retired — nothing reads it and the .example is deleted. These
# two rules stay anyway: a leftover file from before the switch still holds argon2
# hashes, and un-ignoring it would put it one `git add -A` away from being
# committed. Accounts now live in app.db (docs/runbooks/06-changing-users.md).
config/ui-users.json
deploy/local/ui-users.json

# Deliberately local-only working files. Untracked and unignored is one
# `git add -A` away from being committed by accident: the chat log is a
# transcript of local bot sessions, and the offline Dockerfile is a recipe for
# building without a registry on this machine — neither is how the server builds.
control-bot/chathistorylog.txt
deploy/ui-backend.offline.Dockerfile

# Editor / OS
.vscode/
.idea/
.DS_Store

# Dev tooling caches
.pytest_cache/
.ruff_cache/
*.log
.superpowers/
