{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/flow/**",
              "components/forms/**",
              "components/guide/**",
              "components/shell/**",
              "components/surfaces/**",
              "ui_kits/panel/**",
              "ui_kits/staff-guide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Vazirmatn Variable|Vazirmatn))/i]",
        "message": "Font not provided by the design system. Available: Vazirmatn Variable, Vazirmatn."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|actor|conflicts|hasSub|highlighted|onOpenDetail|style|key|ref|className|style|children)$/]",
        "message": "<ActivityNode> doesn't accept that prop. Declared props: id, label, actor, conflicts, hasSub, highlighted, onOpenDetail, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|branches|style|key|ref|className|style|children)$/]",
        "message": "<BranchGroup> doesn't accept that prop. Declared props: type, title, branches, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchGroup'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:XOR|AND|OR)$/]",
        "message": "<BranchGroup> type must be one of 'XOR' | 'AND' | 'OR'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|loading|loadingLabel|block|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, loading, loadingLabel, block, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:coral|violet|green|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'coral' | 'violet' | 'green' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|radius|padding|hoverLift|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: onDark, radius, padding, hoverLift, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: kind, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:input|control|output|mech)$/]",
        "message": "<Chip> kind must be one of 'input' | 'control' | 'output' | 'mech'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConflictCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:nodeId|field|source|current|proposed|onAccept|onReject|action|compact|style|key|ref|className|style|children)$/]",
        "message": "<ConflictCard> doesn't accept that prop. Declared props: nodeId, field, source, current, proposed, onAccept, onReject, action, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|name|index|count|subs|conflicts|cta|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DepartmentCard> doesn't accept that prop. Declared props: code, name, index, count, subs, conflicts, cta, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartmentCard'] > JSXAttribute[name.name='code'] > Literal[value!=/^(?:management|accounting|warehouse|procurement|cooking|preparation|dining|cashier|logistics)$/]",
        "message": "<DepartmentCard> code must be one of 'management' | 'accounting' | 'warehouse' | 'procurement' | 'cooking' | 'preparation' | 'dining' | 'cashier' | 'logistics'."
