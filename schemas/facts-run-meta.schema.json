{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facts-run-meta.schema.json",
  "title": "Facts run metadata — per-run record for a facts pipeline/chat/UI run",
  "type": "object",
  "additionalProperties": false,
  "required": ["department", "origin", "actor", "started_at", "finished_at",
               "recordings", "attachments", "workbooks", "delta", "merged", "ids_created"],
  "properties": {
    "department": { "type": "string", "pattern": "^[a-z]+$" },
    "origin": { "enum": ["pipeline", "chat", "ui"] },
    "actor": { "type": "string" },
    "started_at": { "$ref": "#/$defs/iso" },
    "finished_at": { "oneOf": [{ "$ref": "#/$defs/iso" }, { "type": "null" }] },
    "recordings": { "type": "array", "items": { "type": "string" } },
    "attachments": { "type": "array", "items": { "type": "string" } },
    "workbooks": { "type": "array", "items": { "type": "string" } },
    "delta": { "type": "string" },
    "merged": { "type": "boolean" },
    "ids_created": { "type": "array", "items": { "type": "string" } },
    "units": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "state"],
      "properties": { "id": { "type": "string" },
                      "type": { "enum": ["workbook", "transcript", "items", "attachment"] },
                      "state": { "enum": ["pending", "done", "failed"] },
                      "attempts": { "type": "integer", "minimum": 0 } } } },
    "instruction": { "type": "string" }
  },
  "$defs": {
    "iso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
