{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Facts manifest — branches and workbooks the facts store draws from (design §7 QF-33)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "branches", "workbooks"],
  "properties": {
    "schema_version": { "const": 1 },
    "branches": { "type": "array", "items": { "$ref": "#/$defs/branch" } },
    "workbooks": { "type": "array", "items": { "$ref": "#/$defs/workbook" } }
  },
  "$defs": {
    "branch": { "type": "object", "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z]+$" },
        "name": { "type": "string" } } },
    "workbook": { "type": "object", "additionalProperties": false,
      "required": ["spreadsheetId", "dir", "file", "short", "scripts",
                   "departments", "branches", "reference_tabs", "confirmed"],
      "properties": {
        "spreadsheetId": { "type": "string" },
        "dir": { "type": "string" },
        "file": { "type": "string" },
        "short": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "scripts": { "type": "array", "items": { "type": "string" } },
        "departments": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+$" } },
        "branches": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+$" } },
        "reference_tabs": { "type": "array", "items": { "type": "string" } },
        "unresolved": { "type": "array",
          "items": { "enum": ["departments", "branches", "reference_tabs"] } },
        "twin_of": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "confirmed": { "type": "boolean" } } }
  }
}
