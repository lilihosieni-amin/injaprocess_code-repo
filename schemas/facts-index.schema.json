{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facts-index.schema.json",
  "title": "Facts index — flattened, filterable rows over the facts store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 2 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "mintedKey": { "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*(__[a-z][a-z0-9]*(_[a-z0-9]+)*)*$" },
    "factId": { "type": "string", "pattern": "^F-[0-9]{5}$" },
    "jalali": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
    "iso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "scope": { "type": "object", "additionalProperties": false,
      "properties": {
        "departments": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+$" } },
        "branches":    { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+$" } } } },
    "row": { "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "key", "title", "scope", "status", "retired", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/factId" },
        "kind": { "enum": ["item", "record", "measurement", "rule", "note"] },
        "key": { "$ref": "#/$defs/mintedKey" },
        "title": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "scope": { "$ref": "#/$defs/scope" },
        "status": { "enum": ["confirmed", "inferred", "informal", "disputed", "unknown"] },
        "retired": { "type": "boolean" },
        "valid_to": { "oneOf": [{ "$ref": "#/$defs/jalali" }, { "type": "null" }] },
        "processes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+-[0-9]{3}$" } },
        "field_status_counts": { "type": "object", "additionalProperties": false,
          "properties": {
            "disputed": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 },
            "informal": { "type": "integer", "minimum": 0 },
            "inferred": { "type": "integer", "minimum": 0 } } },
        "stub": { "type": "boolean" },
        "updated_at": { "$ref": "#/$defs/iso" } } }
  }
}
