# UI backend — SAMPLE, no real secrets (ARD §13)
DATA_ROOT=/path/to/data-repo
# where the frozen JSON schemas live (code-repo/schemas), for the engine CLIs
SCHEMA_DIR=/path/to/code-repo/schemas
# single UI user
UI_USERNAME=
# argon2 hash of the UI password (never the plaintext) — NFR-3
UI_PASSWORD_HASH=
# Multiple UI users: path to a JSON file {username: argon2_hash} (real file OUTSIDE git).
# If set, it takes precedence over UI_USERNAME/UI_PASSWORD_HASH above.
UI_USERS_FILE=
# secret for signing the session cookie
SESSION_SIGNING_KEY=
# session lifetime in seconds (default 86400)
SESSION_TTL=86400
# built frontend directory (ui/dist); may be absent until Phase 6
UI_STATIC_DIR=
# Where generated export documents are written. Unset = the export feature is off
# (the endpoint answers 503 and the UI says so). In Docker this is supplied by the
# compose file (`EXPORT_DIR: /exports`, on the ui-exports volume) — leave it blank
# here. For a host run, point it at a directory you can write to, or leave it unset.
EXPORT_DIR=
# The one shared login that opens a published export (/exports/...). Separate from
# the UI users above on purpose: it opens exports and nothing else. Both blank =
# the gate is CLOSED: /exports answers 401 to everyone except a signed-in UI user,
# and no login form is offered. There is no fallback to open access.
# The real values live only in the server's secrets env file, outside both repos.
EXPORT_USERNAME=
# argon2 hash of the export password (never the plaintext) — same recipe as
# UI_PASSWORD_HASH; see docs/runbooks/02-secrets-and-auth.md
EXPORT_PASSWORD_HASH=
# Where the built export templates live. Owned by the image — the Dockerfile sets
# it to /app/ui-export-templates. Leave blank so the image stays the single source
# of truth; only set it for a host run without Docker (then: ui/dist-export).
UI_EXPORT_TEMPLATE_DIR=
# The browser that prints each export to a PDF beside its HTML. Owned by the image
# too — the Dockerfile installs Debian `chromium` and sets this to
# /usr/lib/chromium/chromium. Leave blank; only set it for a host run, and only to
# a Chromium that supports CDP Page.printToPDF (Debian's `chromium-shell` does
# not). Unset simply means exports get no PDF; nothing else changes.
CHROMIUM_PATH=
# author identity for ui-edit commits
GIT_AUTHOR_NAME=ui-edit
GIT_AUTHOR_EMAIL=ui-edit@inja.local
