            "mabnaye_sabt"
          ],
          "rows": [
            {
              "goruh_qalam": "بیکن و ژامبون ورقه‌ای",
              "mabnaye_sabt": "فقط وزن"
            },
            {
              "goruh_qalam": "پنیر گودا",
              "mabnaye_sabt": "کارتن باز یا کارتن بسته"
            },
            {
              "goruh_qalam": "اقلام عددی لاین سوخاری و نان مک و نان باگت",
              "mabnaye_sabt": "تعداد"
            },
            {
              "goruh_qalam": "نوشیدنی‌های کانتر",
              "mabnaye_sabt": "تعداد"
            },
            {
              "goruh_qalam": "سس‌ها، گوجه و خیارشور و جعفری، ظروف، قارچ و روغن سرخ‌کن",
              "mabnaye_sabt": "در مانده پایان شب ثبت نمی‌شود"
            }
          ]
        },
