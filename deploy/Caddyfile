# UI reverse proxy with internal (self-signed) TLS on the server IP (NFR-3).
# To use a real domain later: replace the site address with the domain and
# delete the `tls internal` line — Caddy then auto-provisions Let's Encrypt.
{
	# global options; local CA only
	auto_https disable_redirects
	# A bare IP site has no SNI (clients don't send SNI for an IP address),
	# so tell Caddy which internal cert to present by default. When you move
	# to a real domain, drop this line and change the site address below.
	default_sni 91.107.147.127
}

https://91.107.147.127 {
	tls internal
	# Nothing this service accepts is large: the biggest request is a process
	# document being saved, a few hundred KB of JSON. The reason for the cap is
	# POST /api/exports/login, which is unauthenticated and advertised to every
	# staff member with an export link — without a ceiling, one caller can stream
	# as much as they like into the backend's memory on a 3.7 GB host. Caddy
	# answers 413 above the limit. The handler enforces its own, much smaller
	# ceiling as well, because this proxy is not in front of the local stack.
	request_body {
		max_size 1MB
	}
	reverse_proxy ui-backend:8000
}
